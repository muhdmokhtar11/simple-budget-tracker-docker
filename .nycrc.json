{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "check-coverage": true,
  "include": ["src/main/webapp/app/**/*.{js,ts,tsx}"],
  "exclude": [
    "src/main/webapp/app/**/*.spec.{js,ts,tsx}",
    "src/main/webapp/app/**/*.test.{js,ts,tsx}",
    "src/main/webapp/app/**/*.d.ts",
    "src/main/webapp/app/index.tsx",
    "src/main/webapp/app/bootstrap.tsx",
    "src/main/webapp/app/config/store.ts",
    "src/main/webapp/app/reducers.ts",
    "src/main/webapp/app/entities/reducers.ts",
    "src/main/webapp/app/entities/routes.tsx",
    "src/main/webapp/app/routes.tsx",
    "src/main/webapp/app/modules/home/home.tsx",
    "src/main/webapp/app/modules/login/login.tsx",
    "src/main/webapp/app/modules/login/logout.tsx",
    "src/main/webapp/app/shared/model/**/*.ts",
    "src/main/webapp/app/shared/reducers/**/*.ts",
    "src/main/webapp/app/shared/util/**/*.ts",
    "src/main/webapp/app/shared/auth/**/*.ts",
    "src/main/webapp/app/shared/error/**/*.ts",
    "src/main/webapp/app/shared/jhipster/**/*.ts",
    "src/main/webapp/app/shared/layout/**/*.tsx",
    "src/main/webapp/app/shared/DurationFormat.tsx",
    "src/main/webapp/app/config/**/*.ts",
    "src/main/webapp/app/shared/layout/menus/**/*.tsx",
    "src/main/webapp/app/shared/layout/password/**/*.tsx",
    "src/main/webapp/app/shared/layout/header/**/*.tsx",
    "src/main/webapp/app/shared/layout/footer/**/*.tsx"
  ],
  "reporter": ["html", "text", "text-summary", "lcov", "json"],
  "report-dir": "target/cypress/coverage",
  "temp-dir": "target/cypress/.nyc_output",
  "statements": 80,
  "branches": 80,
  "functions": 80,
  "lines": 80
}
